{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.tianji/scs-01-01/prediction_input.schema.json",
  "title": "SCS-01-01 简化未来任务预测输入",
  "type": "object",
  "required": [
    "time",
    "prediction"
  ],
  "properties": {
    "time": {
      "type": "string",
      "description": "当前遥测时刻，必须为整分钟；无时区时按 Asia/Shanghai"
    },
    "timezone": {
      "type": "string",
      "default": "Asia/Shanghai"
    },
    "prediction": {
      "type": "object",
      "required": [
        "end",
        "phase_segments",
        "tasks"
      ],
      "properties": {
        "end": {
          "type": "string",
          "description": "目标出阴影时刻，必须晚于 time"
        },
        "step_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600,
          "default": 60
        },
        "phase_segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/phase_segment"
          }
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/task"
          }
        }
      },
      "additionalProperties": false
    },
    "assumptions": {
      "type": "object",
      "properties": {
        "battery_capacity_Ah": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "nominal_voltage_V": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "eta_charge": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "eta_discharge": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "soc_floor": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "phase_segment": {
      "type": "object",
      "required": [
        "start",
        "end",
        "phase"
      ],
      "properties": {
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        },
        "phase": {
          "type": "string",
          "description": "sun/阳照/日照 或 eclipse/阴影/地影"
        }
      },
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "oneOf": [
        {
          "required": [
            "unit"
          ],
          "not": {
            "required": [
              "units"
            ]
          }
        },
        {
          "required": [
            "units"
          ],
          "not": {
            "required": [
              "unit"
            ]
          }
        }
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "仅供报告追溯，不参与计算"
        },
        "start": {
          "type": "string",
          "description": "完整时间或 HH:MM[:SS]；仅写时刻时日期继承 time"
        },
        "end": {
          "type": "string",
          "description": "run_mode 对 [start,end) 生效"
        },
        "unit": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "units": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              }
            }
          ]
        },
        "run_mode": {
          "type": "string",
          "default": "active",
          "description": "任务窗口内模式"
        },
        "after_mode": {
          "type": "string",
          "default": "restore",
          "description": "end 后到下一任务开始或预测结束的模式；restore 表示恢复当前遥测功率"
        },
        "power_level": {
          "type": "string",
          "description": "可选工作功率层"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
