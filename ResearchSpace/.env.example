# ClickHouse 连接配置模板
# 使用方法: 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 排除，不会入库）
#   环境变量优先级高于 .env；两者都不设置时，口令为空（查询将认证失败，属有意行为）

CH_HOST=10.200.56.174
# HTTP 接口 8123（ch_http.py 默认）；原生端口 9000 仅 clickhouse-driver（04/05）使用
CH_PORT=8123
CH_USER=default
# 查询口令：不要提交到 git，不要写进任何 .py 文件
CH_PASSWORD=
CH_DB=chdb_3body
