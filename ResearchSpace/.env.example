# ClickHouse 连接配置模板
# 使用方法: 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 排除，不会入库）
#   环境变量优先级高于 .env；两者都不设置时，口令为空（查询将认证失败，属有意行为）

CH_HOST=10.200.56.174
# 当前评估链使用 ClickHouse 原生协议端口 9000。
CH_NATIVE_PORT=9000
CH_NATIVE_SECURE=0
CH_USER=default
# 查询口令：不要提交到 git，不要写进任何 .py 文件
CH_PASSWORD=
CH_DB=chdb_3body
# 仅在明确接受明文传输风险时，对本次运行显式放行原生明文连接。
# 未设置时，携带口令的连接默认拒绝。不要把实际口令写入此模板。
# CH_ALLOW_PLAINTEXT=1
